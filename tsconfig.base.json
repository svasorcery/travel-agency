{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@travel/api-client": ["shared/ts/api-client/src/index.ts"],
      "@travel/api-client/testing/trips": ["shared/ts/api-client/src/trips.vectors.ts"],
      "@travel/api-client/trips-decoder": ["shared/ts/api-client/src/trips.decoder.ts"],
      "@travel/trips-itinerary-fixtures": ["tests/fixtures/trips-itinerary-v1/index.ts"],
      "@travel/demo/rail-search": ["tools/demo/rail-search.mjs"],
      "@travel/ui-kit": ["shared/ts/ui-kit/src/index.ts"]
    }
  }
}
