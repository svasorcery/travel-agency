{
  "name": "travel-agency",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nx affected -t build",
    "test": "nx affected -t test",
    "lint": "nx affected -t lint",
    "format": "biome format --write .",
    "aspire": "dotnet run --project apps/Travel.AppHost",
    "openspec": "node tools/openspec/run.mjs",
    "test:ai-harness": "node --test tools/ai-harness/validate.test.mjs tools/ai-harness/verify-codex.test.mjs",
    "check:ai-harness": "npm run test:ai-harness && node tools/ai-harness/validate.mjs",
    "check:readme-examples": "node --test tools/docs/readme-examples.test.mjs tools/docs/readme-smoke.test.mjs && node tools/docs/readme-examples.mjs --check",
    "smoke:readme": "node tools/docs/readme-smoke.mjs",
    "test:flights-demo": "node --test tools/demo/flights-search-api.test.mjs tools/demo/support-cases.test.mjs && node node_modules/vitest/vitest.mjs run --config tools/rail/vitest.config.mts tools/rail/rail-fictional.spec.ts && playwright test -c tests/travel-e2e/playwright.flights-demo.config.ts",
    "verify:ai-harness:codex": "node tools/ai-harness/verify-codex.mjs",
    "test:dotnet-inventory": "node --test tools/ci/validate-dotnet-inventory.test.mjs",
    "check:dotnet-inventory": "npm run test:dotnet-inventory && node tools/ci/validate-dotnet-inventory.mjs",
    "test:dependencies": "node --test tools/ci/dependency-audit.test.mjs",
    "test:dependency-consumers": "node --test tools/ci/dependency-compatibility.test.mjs",
    "check:dependencies": "npm run test:dependencies && npm run test:security-patches && node tools/ci/dependency-audit.mjs",
    "commit": "cz",
    "prepare": "lefthook install",
    "test:security-patches": "node --test tools/security/braces.test.mjs tools/security/braces-artifact.test.mjs",
    "check:dependency-artifacts": "node tools/ci/dependency-audit.mjs --artifacts-only"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@angular-devkit/core": "~21.2.24",
