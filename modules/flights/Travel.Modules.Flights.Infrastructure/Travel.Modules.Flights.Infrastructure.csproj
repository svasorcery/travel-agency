             Microsoft.Extensions.Http.Resilience pattern for opting a named client out of
             the global AddStandardResilienceHandler registered by ServiceDefaults. -->
        <NoWarn>$(NoWarn);EXTEXP0001</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="MailKit" />
