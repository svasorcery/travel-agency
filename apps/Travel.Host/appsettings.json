{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Audience": "travel-web"
  },
  "Flights": {
    "FeatureFlags": {
      "Travelpayouts": { "Enabled": false },
      "NlSearch": { "Enabled": true }
    },
    "Duffel": {
      "BaseUrl": "https://api.duffel.com",
      "ApiVersion": "v2",
      "TimeoutSeconds": 10,
      "SearchTimeoutSeconds": 4
    },
    "Travelpayouts": {
      "BaseUrl": "https://api.travelpayouts.com",
      "ApiVersion": "v3",
      "TimeoutSeconds": 4
    },
    "Providers": {
      "Frankfurter": {
        "BaseAddress": "https://api.frankfurter.app/",
        "TimeoutSeconds": 2
      }
    },
    "Keycloak": {
      "Realm": "travel"
    }
  }
}
