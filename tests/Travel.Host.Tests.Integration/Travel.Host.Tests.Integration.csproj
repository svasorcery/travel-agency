<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- AD0001: the ASP.NET RouteHandlerAnalyzer throws IndexOutOfRangeException when it
             analyses the MapPost/MapGet calls in FlightsApiFixture (cross-assembly endpoint
             method groups). It is a known analyzer bug, not a code defect — keep it a warning. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);AD0001</WarningsNotAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Alba" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
        <PackageReference Include="Aspire.Hosting.Testing" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Verify.XunitV3" />
        <PackageReference Include="Testcontainers" />
        <PackageReference Include="Testcontainers.PostgreSql" />
        <PackageReference Include="NATS.Client.Core" />
        <ProjectReference
            Include="..\..\apps\Travel.Host\Travel.Host.csproj"
            Aliases="global,TravelHostApp"
        />
        <ProjectReference Include="..\..\apps\Travel.AI\Travel.AI.csproj" Aliases="TravelAiApp" />
        <ProjectReference Include="..\..\apps\Travel.ServiceDefaults\Travel.ServiceDefaults.csproj" />
        <ProjectReference
            Include="..\..\apps\Travel.AppHost\Travel.AppHost.csproj"
            Aliases="AppHost"
        />
        <ProjectReference Include="..\..\shared\dotnet\Travel.Shared.TestInfrastructure\Travel.Shared.TestInfrastructure.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile
            Include="../hotels/Travel.Modules.Hotels.Tests.Integration/HotelM2MemoryFixture.cs"
            Link="Hotels/HotelM2MemoryFixture.cs"
        />
        <Compile
            Include="../fixtures/dotnet/FlightPiiTestRing.cs"
            Link="Fixtures/FlightPiiTestRing.cs"
        />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../modules/support/Travel.Modules.Support.Api/Travel.Modules.Support.Api.csproj" />
        <ProjectReference Include="../../shared/dotnet/Travel.IntegrationContracts.Flights/Travel.IntegrationContracts.Flights.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None
            Include="../hotels/Travel.Modules.Hotels.Tests.Integration/Fixtures/*.json"
            Link="HotelsFixtures/%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
        <None
            Include="../../infra/keycloak/travel-realm.json"
            Link="Fixtures/SupportOperatorIssuanceRealm.json"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
    <ItemGroup>
        <Compile
            Include="../trips/Travel.Modules.Trips.Tests.Integration/TripsTestRing.cs"
            Link="Trips/TripsTestRing.cs"
        />
    </ItemGroup>
</Project>
